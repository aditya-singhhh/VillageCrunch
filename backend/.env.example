# ---- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Public URL of the site (used for CORS, emails, sitemap). Internal example: https://shop.internal.example.com
FRONTEND_URL=http://localhost:8080
# Extra allowed browser origins, comma separated (optional)
CORS_ORIGINS=
# Number of reverse proxies in front of the app (Nginx/Caddy = 1)
TRUST_PROXY=1

# ---- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/villagecrunch

# ---- Auth (REQUIRED) --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Payments (use rzp_test_ keys for internal/staging) ----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Notifications ----------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=
SMS_SERVICE=            # textlocal | fast2sms | twilio | (empty = disabled)
TEXTLOCAL_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Uploads ----------------------------------------------------------------
# Mount this path as a persistent volume
UPLOAD_DIR=/data/uploads

# ---- Tuning (optional) ------------------------------------------------------
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
# Development only: expose password reset token/OTP in logs/response when email/SMS is unavailable
EXPOSE_DEV_RESET_TOKEN=false
CSP_ALLOW_ANALYTICS=false
