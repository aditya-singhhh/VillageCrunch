{
  "hosting": {
    "public": "backend/frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "/robots.txt",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "/uploads/**",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "/Product_Images/**",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "/Review_Images/**",
        "run": {
          "serviceId": "villagecrunch",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/packaging/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
